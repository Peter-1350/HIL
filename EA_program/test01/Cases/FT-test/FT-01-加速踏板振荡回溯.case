    <StepItem ID="test_8b6d2713f2a54e9ba9c4113400000056" Name="ResetReadyRetry" TestType="TCS">
      <NamespaceItem xsi:type="NamespaceItem" Name="pedal_oscillation">
        <RefCount>1</RefCount>
      </NamespaceItem>
      <Path>/FT-01_加速踏板振荡批次/批次Loop</Path>
      <Action>ResetReadyRetry</Action>
      <Parameter xsi:type="Parameter">
        <Text>ready_light = $ReadyLight, max_attempts = 3</Text>
        <Metadata xsi:type="FuncMetadata">
          <CanSaveValue>true</CanSaveValue>
          <CanEvaluation>false</CanEvaluation>
          <Variable>RetryState</Variable>
          <Constant />
          <Value />
          <MetadataCollection>
            <DicMetadata>
              <Key>ready_light</Key>
              <Value>$ReadyLight</Value>
            </DicMetadata>
            <DicMetadata>
              <Key>max_attempts</Key>
              <Value>3</Value>
            </DicMetadata>
          </MetadataCollection>
        </Metadata>
      </Parameter>
      <Value>RetryState</Value>
      <Comment>Ready 已亮则跳过重试；否则最多允许三次完整上电尝试</Comment>
      <IsCommented>false</IsCommented>
    </StepItem>
    <StepItem ID="test_8b6d2713f2a54e9ba9c4113400000055" Name="上电重试" TestType="TCG">
      <Path>/FT-01_加速踏板振荡批次/批次Loop</Path>
      <Action>While</Action>
      <Parameter xsi:type="Parameter">
        <Text>$RetryState == 0</Text>
        <Metadata xsi:type="WhileMetadata">
          <Expression>$RetryState == 0</Expression>
          <ExpressionEditMode>Easy</ExpressionEditMode>
        </Metadata>
      </Parameter>
      <Value />
      <Comment>每轮依次下电、空挡、制动、上电，并重新读取 Ready</Comment>
      <IsCommented>false</IsCommented>
    </StepItem>
